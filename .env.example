# MongoDB Atlas Connection URI (keep secret in Render / .env)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Default database name if not specified in request body
DEFAULT_DATABASE=tasks_db

# Proxy API Key (clients must provide this in x-api-key header)
PROXY_API_KEY=your-secure-random-api-key

# Allowed CORS origins (comma-separated, e.g. your frontend domain or *)
CORS_ORIGINS=https://tu-dominio.com,http://localhost:5173,http://localhost:3000
